---
import { Image } from 'astro:assets';
import type { Post } from '../posts';
import { postSlug } from '../posts';
import { url, formatDate, slugifyTag, readingTime } from '../utils';
import { TEAMS } from '../consts';

interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const { title, description, date, tags, category, team, cover, coverAlt } = post.data;
const href = url(`/blog/${postSlug(post)}/`);
---
<article class:list={['card', { featured, 'has-cover': !!cover }]} data-team={team}>
  {cover && (
    <a href={href} class="cover" tabindex="-1" aria-hidden="true">
      <Image src={cover} alt={coverAlt ?? ''} widths={[480, 800, 1200]} sizes={featured ? '(max-width: 900px) 100vw, 640px' : '(max-width: 700px) 100vw, 380px'} />
    </a>
  )}
  <div class="body">
    <p class="meta mono">
      {team && <span class="team-chip" title={TEAMS[team].hint}>{TEAMS[team].label}</span>}
      <span class="cat">{category}</span>
      <span aria-hidden="true">·</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min</span>
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p class="desc">{description}</p>
    {tags.length > 0 && (
      <ul class="tags">
        {tags.map((t) => <li><a class="tag" href={url(`/tags/${slugifyTag(t)}/`)}>#{t}</a></li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; transition: border-color .15s, transform .15s, box-shadow .15s; position: relative; }
  .card[data-team] { border-top: 2px solid var(--team); }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); transform: translateY(-2px); box-shadow: 0 10px 30px -18px rgba(0,0,0,.6); }
  .cover { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--dark); border-bottom: 1px solid var(--line); }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
  .card:hover .cover :global(img) { transform: scale(1.03); }
  .body { padding: 22px 24px 24px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .cat { color: var(--accent); font-weight: 700; }
  h3 { font-size: 19px; font-weight: 700; line-height: 1.3; }
  h3 a::after { content: ""; position: absolute; inset: 0; }
  h3 a:hover { color: var(--accent); }
  .desc { color: var(--muted); font-size: 14.5px; flex: 1; }
  .tags { position: relative; z-index: 1; margin-top: 4px; }

  .featured { display: grid; grid-template-columns: 1.15fr 1fr; }
  .featured:not(.has-cover) { grid-template-columns: 1fr; }
  .featured .cover { aspect-ratio: auto; min-height: 300px; border-bottom: none; border-right: 1px solid var(--line); }
  .featured .body { padding: 32px; justify-content: center; }
  .featured h3 { font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; }
  .featured .desc { flex: 0; font-size: 16px; }
  @media (max-width: 860px) {
    .featured { grid-template-columns: 1fr; }
    .featured .cover { aspect-ratio: 16 / 9; min-height: 0; border-right: none; border-bottom: 1px solid var(--line); }
    .featured .body { padding: 22px 24px 24px; }
  }
</style>
