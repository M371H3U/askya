---
import Logo from './Logo.astro';
import { url } from '../utils';
import { LINKS, SITE_TAGLINE } from '../consts';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="f-brand">
      <a href={url('/')} class="f-logo"><Logo size={22} /> askya</a>
      <p>{SITE_TAGLINE}</p>
    </div>
    <ul class="f-links">
      <li><a href={url('/blog/')}>Articles</a></li>
      <li><a href={url('/tags/')}>Thèmes</a></li>
      <li><a href={url('/a-propos/')}>À propos</a></li>
      <li><a href={url('/rss.xml')}>RSS</a></li>
      <li><a href={LINKS.github} rel="me noopener" target="_blank">GitHub</a></li>
      <li><a href={LINKS.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      <li><a href={LINKS.dekortix} rel="noopener" target="_blank">Dekortix</a></li>
    </ul>
  </div>
  <div class="wrap f-bottom mono">
    <span>© {year} askya · Contenu publié à des fins éducatives, tests réalisés dans un cadre autorisé.</span>
  </div>
</footer>

<style>
  .footer { background: var(--dark); color: var(--on-dark-muted); margin-top: 96px; border-top: 1px solid rgba(255,255,255,.06); }
  .footer .wrap { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; padding-top: 40px; padding-bottom: 28px; }
  .f-logo { display: inline-flex; align-items: center; gap: 9px; color: #fff; font-weight: 800; font-size: 18px; letter-spacing: -.03em; }
  .f-brand p { margin-top: 8px; font-size: 14px; }
  .f-links { display: flex; flex-wrap: wrap; gap: 10px 24px; list-style: none; margin: 0; padding: 0; font-size: 14px; }
  .f-links a:hover { color: #fff; }
  .f-bottom.wrap { border-top: 1px solid rgba(255,255,255,.08); padding-top: 18px; padding-bottom: 24px; font-size: 11.5px; color: #64748B; }
</style>
